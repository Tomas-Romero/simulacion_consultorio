{
  "name": "simulacion-sobreturnos",
  "private": true,
  "version": "0.1.0",
  "description": "Simulación de un policonsultorio para decidir cuántos sobreturnos dar y dónde ubicarlos (UTN FRSR, Simulación 2026)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.motor.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validar": "tsx scripts/validar.ts",
    "validar-modelo": "tsx scripts/validar-modelo.ts",
    "cobertura": "tsx scripts/cobertura.ts",
    "rendimiento": "tsx scripts/rendimiento.ts",
    "dia": "tsx scripts/dia.ts",
    "calibrar": "tsx scripts/calibrar.ts",
    "barrido-control": "tsx scripts/barrido-control.ts",
    "estudio": "tsx scripts/estudio.ts",
    "estudio-navegador": "node scripts/estudio-navegador.mjs",
    "complementos": "tsx scripts/complementos.ts",
    "capturas": "node scripts/capturas.mjs",
    "medir-fps": "node scripts/medir-fps.mjs",
    "dinamica": "tsx scripts/dinamica.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
